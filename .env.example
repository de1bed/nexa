# ---------------------------------------------------------------------------
# NEXA VISIT
#
# Sin credenciales de Supabase la plataforma arranca en MODO VITRINA: recorrido
# completo con datos locales, sin base de datos. En cuanto pegues la URL y la
# anon key de tu proyecto, la plataforma pasa sola a modo real con Auth, RLS y
# almacenamiento privado. No hay que tocar código.
#
# Todo lo demás es opcional. Guía paso a paso en docs/INTEGRACIONES.md
# ---------------------------------------------------------------------------

# --- Base de datos (npx supabase start, o un proyecto en la nube) ------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origen público, usado para construir enlaces de invitación y pases.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Correo de la aplicación ------------------------------------------------
# Invitaciones, pases y avisos de llegada. Sin API key se registran en consola.
# El CÓDIGO DE ACCESO de seis dígitos no sale de aquí: lo envía Supabase Auth,
# así que además hay que activar el SMTP de Resend en el panel de Supabase
# (Authentication → Emails) o nadie podrá iniciar sesión. Paso a paso en
# docs/INTEGRACIONES.md
RESEND_API_KEY=
RESEND_FROM_EMAIL=NEXA VISIT <visitas@example.com>

# --- Retención de documentos ------------------------------------------------
# Secreto del cron diario; Vercel lo envía como Bearer.
CRON_SECRET=

# --- Lectura de identificaciones --------------------------------------------
# "tesseract" lee la banda MRZ del reverso en el propio dispositivo.
# Requiere haber ejecutado: npm run setup:ocr
NEXT_PUBLIC_OCR_PROVIDER=mock

# --- Carteras del teléfono (opcional) ---------------------------------------
# Google Wallet: cuenta de servicio de Google Cloud, sin costo de licencia.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=nexa_visit_pass

# Apple Wallet: requiere el Apple Developer Program y un Pass Type ID.
# Los certificados se guardan en base64 para que quepan en una variable.
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_ORG_NAME=
APPLE_WALLET_CERT=
APPLE_WALLET_KEY=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR=

# --- WhatsApp (opcional) ----------------------------------------------------
# API de Meta Cloud. Requiere una plantilla aprobada por Meta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=nexa_visit_invitation
WHATSAPP_TEMPLATE_LANG=es_MX
WHATSAPP_DEFAULT_COUNTRY_CODE=52

# --- Solo para demostraciones -----------------------------------------------
# Fuerza el modo vitrina aunque existan credenciales de Supabase.
NEXT_PUBLIC_DEMO_MODE=
