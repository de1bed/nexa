# Supabase (use `supabase start` locally or a cloud project)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Public application origin used to generate invitation and QR links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional email provider. When absent, links are logged in development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NEXA VISIT <visitas@example.com>

# Use local adapters for the reproducible demo
NEXT_PUBLIC_DEMO_MODE=true
OCR_PROVIDER=mock
DEMO_QR_TOKEN=nexa-demo-pass-2026
